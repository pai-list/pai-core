{
  "name": "@pai/validators",
  "version": "0.1.0",
  "description": "PAI Validators - AgentAppValidator, CloudflareValidator, VercelValidator, PiAppValidator with risk scoring",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
